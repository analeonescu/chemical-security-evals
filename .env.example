# Copy this file to .env and fill in your keys:
#
#     cp .env.example .env
#
# .env is gitignored. Never commit real keys, and never put one in this file.
# Anything exported in your shell takes precedence over the values here.

# Google AI Studio -- models under test and Gemini judges.
# Inspect reads GOOGLE_API_KEY; the dataset builders accept either name.
GOOGLE_API_KEY=
GEMINI_API_KEY=

# Groq -- Llama and GPT-OSS judges.
GROQ_API_KEY=
